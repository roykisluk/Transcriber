#!/usr/bin/env zsh
# transcribe <file> [more files...]
# Converts each input to 16 kHz mono wav and transcribes it to Hebrew with
# whisper.cpp, writing <input-without-ext>.txt and .srt next to the input.
# Override the model with TRANSCRIBE_MODEL=/path/to/model.bin.
set -uo pipefail

# ${0:A} resolves symlinks, so this points at the repo dir even when this
# script is invoked via a ~/bin symlink (the model lives beside it there).
MODEL=${TRANSCRIBE_MODEL:-"${0:A:h}/ggml-model-whisper-custom.bin"}
VAD_MODEL=${TRANSCRIBE_VAD_MODEL:-"${0:A:h}/ggml-silero-v5.1.2.bin"}

if (( $# == 0 )); then
  print -u2 "usage: transcribe <file> [more files...]"
  exit 2
fi
if [[ ! -f $MODEL ]]; then
  print -u2 "transcribe: model not found: $MODEL"
  print -u2 "            set TRANSCRIBE_MODEL or run install.sh."
  exit 1
fi
if ! command -v whisper-cli >/dev/null 2>&1; then
  print -u2 "transcribe: whisper-cli not found (brew install whisper-cpp / run install.sh)."
  exit 1
fi

# VAD on by default (drops whisper's silence-gap hallucinations); TRANSCRIBE_VAD=0
# to disable. Missing VAD model => warn once and continue without it, don't fail.
vad_args=()
if [[ ${TRANSCRIBE_VAD:-1} != 0 ]]; then
  if [[ -f $VAD_MODEL ]]; then
    vad_args=(--vad --vad-model "$VAD_MODEL")
  else
    print -u2 "transcribe: VAD model not found ($VAD_MODEL); continuing without VAD (TRANSCRIBE_VAD=0 to silence, or run install.sh)."
  fi
fi

# Optional vocabulary biasing: nudges spelling of domain terms. Unset => stock behavior.
prompt_args=()
[[ -n ${TRANSCRIBE_PROMPT:-} ]] && prompt_args=(--prompt "$TRANSCRIBE_PROMPT")

tmpdir=""
cleanup() { [[ -n $tmpdir && -d $tmpdir ]] && rm -rf "$tmpdir"; }
trap cleanup EXIT INT TERM

failed=0
for input in "$@"; do
  if [[ ! -f $input ]]; then
    print -u2 "transcribe: skip (not a file): $input"
    failed=1
    continue
  fi
  base=${input:r}                 # strip extension, keep directory
  tmpdir=$(mktemp -d)
  wav="$tmpdir/audio.wav"

  print "transcribe: $input"
  if ! ffmpeg -nostdin -hide_banner -loglevel error -y \
      -i "$input" -ar 16000 -ac 1 -c:a pcm_s16le "$wav"; then
    print -u2 "transcribe: ffmpeg failed, skipping: $input"
    rm -rf "$tmpdir"; tmpdir=""
    failed=1
    continue
  fi
  if ! whisper-cli -m "$MODEL" -l he "${vad_args[@]}" "${prompt_args[@]}" -otxt -osrt -of "$base" -f "$wav"; then
    print -u2 "transcribe: whisper-cli failed, skipping: $input"
    rm -rf "$tmpdir"; tmpdir=""
    failed=1
    continue
  fi

  rm -rf "$tmpdir"; tmpdir=""
  print "  -> $base.txt"
  print "  -> $base.srt"
done

exit $failed
