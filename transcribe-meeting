#!/usr/bin/env zsh
# transcribe-meeting <recording.m4a>
# Split-channel transcription for "Meeting Input" aggregate recordings.
# The aggregate records mic channels FIRST, BlackHole's 2 channels LAST, so:
# ponytail: assumes AAC's canonical channel layout preserves the capture order —
# unverified until a real >=3ch recording; if [Me]/[Them] come out swapped, this
# mapping is the place to fix.
#   near ("[Me]")   = downmix of channels 0 .. N-3   (your mic)
#   far  ("[Them]") = downmix of the last two, N-2,N-1 (system / Zoom)
# Transcribes each side separately, then merges the two .srt by start time into
# one speaker-labeled <recording>.txt next to the recording.
#
# Legacy/mono files (1 or 2 channels) have no separate far end, so they fall
# through to plain `transcribe` — old single-track recordings keep working.
set -uo pipefail

# ${0:A:h} = repo dir even via a ~/bin symlink; use the sibling transcribe so
# the model/VAD/prompt resolution stays version-consistent with this helper.
TRANSCRIBE=${0:A:h}/transcribe

if (( $# != 1 )); then
  print -u2 "usage: transcribe-meeting <recording.m4a>"
  exit 2
fi
input=$1
[[ -f $input ]] || { print -u2 "transcribe-meeting: not a file: $input"; exit 1; }
command -v ffprobe >/dev/null 2>&1 || { print -u2 "transcribe-meeting: ffprobe not found (run install.sh)."; exit 1; }
base=${input:r}

n=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels -of csv=p=0 "$input" 2>/dev/null)
if [[ -z $n || $n -lt 3 ]]; then
  # 1-2 channels: no split possible -> ordinary single-track transcript.
  exec "$TRANSCRIBE" "$input"
fi

tmp=$(mktemp -d)
cleanup() { [[ -d $tmp ]] && rm -rf "$tmp"; }
trap cleanup EXIT INT TERM

# Build pan mixdowns. near = average of channels 0..n-3; far = average of last two.
near_n=$((n - 2))
near_coef=$(printf '%.6f' $(( 1.0 / near_n )))
near_mix="c0=${near_coef}*c0"
for (( i = 1; i < near_n; i++ )); do near_mix+="+${near_coef}*c$i"; done
far_mix="c0=0.5*c$((n - 2))+0.5*c$((n - 1))"

if ! ffmpeg -nostdin -hide_banner -loglevel error -y -i "$input" \
     -filter_complex "[0:a]asplit=2[na][fa];[na]pan=mono|${near_mix}[near];[fa]pan=mono|${far_mix}[far]" \
     -map "[near]" -ar 16000 -c:a pcm_s16le "$tmp/near.wav" \
     -map "[far]"  -ar 16000 -c:a pcm_s16le "$tmp/far.wav"; then
  print -u2 "transcribe-meeting: channel split failed: $input"
  exit 1
fi

# whisper writes near.srt / far.srt beside each input (in $tmp).
"$TRANSCRIBE" "$tmp/near.wav" "$tmp/far.wav" || {
  print -u2 "transcribe-meeting: transcription failed: $input"; exit 1; }

# One awk pass per side: emit "<zero-padded start seconds>\t<label> <text>".
# Fixed-width key => lexical sort == time order; empty/missing side emits nothing.
emit() {  # emit <label> <srt-file>
  [[ -f $2 ]] || return 0
  awk -v label="$1" '
    / --> / {
      split($1, t, /[:,]/)
      sec = t[1]*3600 + t[2]*60 + t[3] + t[4]/1000
      txt = ""
      while ((getline line) > 0 && line != "") {
        gsub(/^[ \t]+|[ \t]+$/, "", line)
        txt = (txt == "" ? line : txt " " line)
      }
      if (txt != "") printf "%014.3f\t%s %s\n", sec, label, txt
    }' "$2"
}
{ emit "[Me]" "$tmp/near.srt"; emit "[Them]" "$tmp/far.srt"; } \
  | sort | cut -f2- > "$base.txt"

print "  -> $base.txt (labeled [Me]/[Them])"
