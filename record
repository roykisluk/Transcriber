#!/usr/bin/env zsh
# record [name]
# Records mic + everything the Mac plays to ~/Recordings/<name>-<timestamp>.m4a.
# The far end is a CoreAudio process tap (meeting-capture), so it works whatever
# output device the call app uses, even muted. Ctrl-C stops.
set -uo pipefail

name_arg=${1:-}            # empty unless the user actually named the meeting
name=${name_arg:-meeting}  # filename stem only; never used as the Notion title
MEETING_CAPTURE=${MEETING_CAPTURE:-"$HOME/bin/meeting-capture"}

command -v ffmpeg >/dev/null 2>&1 || { print -u2 "record: ffmpeg not found (run install.sh)."; exit 1; }
[[ -x $MEETING_CAPTURE ]] || { print -u2 "record: $MEETING_CAPTURE missing (run install.sh)."; exit 1; }

# Mic's own rate; mic channels + the tap's 2 (no resampling, no downmix).
read rate nch <<<"$("$MEETING_CAPTURE" --format)"
if [[ -z ${nch:-} ]]; then
  print -u2 "record: could not set up audio capture (see message above)."
  exit 1
fi

# Record until Ctrl-C. `|| true` so a SIGINT stop still prints the next step.
# Capture ALL channels as-is (no downmix): mic first, the tap last,
# so transcribe-meeting can split near (mic/[Me]) from far (system/[Them]).
mkdir -p "$HOME/Recordings"
out="$HOME/Recordings/${name}-$(date +%Y%m%d-%H%M%S).m4a"
print "Recording mic + system audio ($rate Hz, $nch ch) -> $out"
print "Press Ctrl-C ONCE to stop (repeated presses hard-kill ffmpeg)."
# Capture is meeting-capture, NOT ffmpeg's avfoundation input, which drops ~10%
# of samples at 48 kHz (lesson log 2026-10-17); ffmpeg only encodes. Layout 3.0
# for 3 channels: the default 2.1 makes the last (tap) channel LFE, which AAC
# cuts to bass only.
layout=()
(( nch == 3 )) && layout=(-ch_layout 3.0)
# Fragmented mp4 (empty_moov + 5s fragments): file stays readable even if
# ffmpeg is hard-killed (e.g. repeated Ctrl-C) — at most the last ~5s are lost.
# Backgrounded so the language prompt below costs ZERO audio: capture is already
# running while it waits. -nostdin so ffmpeg doesn't swallow that keypress.
# $! is ffmpeg (last in the pipeline); meeting-capture exits when ffmpeg closes
# the pipe.
"$MEETING_CAPTURE" | ffmpeg -nostdin -hide_banner -loglevel warning \
  -f f32le -ar "$rate" -ac "$nch" $layout -i pipe:0 \
  -c:a aac -b:a 96k \
  -movflags +empty_moov+default_base_moof -frag_duration 5000000 "$out" &
ff_pid=$!

# zsh without job control does NOT forward the terminal's SIGINT to a background
# job, so Ctrl-C has to be relayed by hand. SIGINT (never KILL) so ffmpeg
# finalizes the file on the way out.
stop() { kill -INT "$ff_pid" 2>/dev/null || true; }
trap stop INT TERM

# RECORD_CONTROL=<pidfile>: started by Hammerspoon's zoom_record, whose popup
# answers instead of the terminal prompt below — by signal, to the pid written
# here. USR1 = discard (stop + delete), USR2 = English. Traps go in before the
# pid is published, since both signals kill by default.
lang=he
discard=0
if [[ -n ${RECORD_CONTROL:-} ]]; then
  trap 'discard=1; stop' USR1
  trap 'lang=en' USR2
  print $$ > "$RECORD_CONTROL"
fi

# Language, asked WHILE recording — it isn't needed until transcription (after
# Ctrl-C), so a slow answer costs no audio. Default Hebrew on N / silence / no tty.
# The 5s timeout is enforced by the tty driver (min 0 time 50 = return after at
# most 5s with whatever's there), NOT by `read -t`: zsh's `read -q -t5` never
# times out at all, and `read -k1 -t5` proved unreliable here. The driver can't
# hang, so a missed keypress can never strand a recording. Tested 2026-08-11.
if [[ -z ${RECORD_CONTROL:-} && -t 0 ]]; then
  stty_saved=$(stty -g 2>/dev/null || true)
  if [[ -n $stty_saved ]] && stty -icanon min 0 time 50 2>/dev/null; then
    print -n "Meeting in English? [y/N] (5s, default Hebrew) "
    ans=$(dd bs=1 count=1 2>/dev/null)
    stty "$stty_saved" 2>/dev/null || true
    [[ $ans == [yY] ]] && lang=en
    print ""
  fi
fi

# `wait` is interrupted by the trap, so loop until ffmpeg is actually gone.
while kill -0 "$ff_pid" 2>/dev/null; do wait "$ff_pid" 2>/dev/null || true; done
# Language printed after the stop: with RECORD_CONTROL it can change mid-recording.
print "Language: $lang"
export TRANSCRIBE_LANG=$lang
if [[ -n ${RECORD_CONTROL:-} ]]; then
  rm -f "$RECORD_CONTROL"
  if (( discard )); then
    rm -f "$out"
    print "Discarded: $out"
    exit 0
  fi
fi

print ""
if [[ ! -f $out ]]; then
  print -u2 "record: no file was written."
  exit 1
fi
print "Saved: $out"
txt="${out:r}.txt"

# Pass the user's name to Notion only if they actually gave one.
nm=("$out")
[[ -n $name_arg ]] && nm+=("$name_arg")

# tbox's GPU (ivrit-ai turbo) first; `tbox transcribe` splits [Me]/[Them] itself.
# timeout: ssh's ConnectTimeout doesn't cover the Cloudflare ProxyCommand.
here=${0:A:h}   # inside a function $0 is the function's name
tx() {
  timeout 20 ssh -o BatchMode=yes devbox true 2>/dev/null \
    && zsh -ic "tbox transcribe -l $lang ${(q)out}" && return
  print -u2 "record: tbox unreachable or failed — transcribing on this Mac."
  "$here/transcribe-meeting" "$out"
}
if ! tx; then
  print -u2 "record: transcription failed."
  print -u2 "Recording is safe at: $out"
  print -u2 "Retry with:  notion-meeting \"$out\"${name_arg:+ \"$name_arg\"}"
  exit 1
fi
if ! "${0:A:h}/notion-meeting" "${nm[@]}"; then
  print -u2 "record: Notion upload failed (transcript is on disk)."
  print -u2 "Retry with:  notion-meeting \"$out\"${name_arg:+ \"$name_arg\"}"
  exit 1
fi

print ""
print "Saved:      $out"
print "Transcript: $txt"
# notion-meeting already printed the page URL as "Notion: <url>"
