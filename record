#!/usr/bin/env zsh
# record [name]
# Records mic + system audio to ~/Recordings/<name>-<timestamp>.m4a via the
# "Meeting Input" aggregate. Switches the default output to "Meeting Output"
# for the duration and restores it on exit (including Ctrl-C). Ctrl-C stops.
set -uo pipefail

name_arg=${1:-}            # empty unless the user actually named the meeting
name=${name_arg:-meeting}  # filename stem only; never used as the Notion title
MEETING_DEVICES=${MEETING_DEVICES:-"$HOME/bin/meeting-devices"}

for tool in ffmpeg SwitchAudioSource; do
  command -v "$tool" >/dev/null 2>&1 || { print -u2 "record: $tool not found (run install.sh)."; exit 1; }
done
[[ -x $MEETING_DEVICES ]] || { print -u2 "record: $MEETING_DEVICES missing (run install.sh)."; exit 1; }

# 1. Ensure the aggregate devices exist / match the current defaults.
"$MEETING_DEVICES" || { print -u2 "record: audio device setup failed (see message above)."; exit 1; }

# 2. Remember the current default output so we can restore it.
prev_out=$(SwitchAudioSource -c -t output 2>/dev/null || true)
if [[ $prev_out == "Meeting Output" ]]; then
  # Stale state (a previous run didn't restore): fall back to a real output.
  prev_out=$(SwitchAudioSource -a -t output 2>/dev/null | grep -v '^Meeting Output$' | head -1)
fi

restore() {
  [[ -n ${prev_out:-} ]] && SwitchAudioSource -t output -s "$prev_out" >/dev/null 2>&1 || true
}
trap restore EXIT INT TERM

# 3. Route system audio through Meeting Output (so BlackHole hears it too).
SwitchAudioSource -t output -s "Meeting Output" >/dev/null || {
  print -u2 "record: failed to switch output to 'Meeting Output' (system audio would be missing); aborting."
  exit 1
}

# 4. Resolve the avfoundation audio-device index of "Meeting Input" by name.
dev_list=$(ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 || true)
idx=$(print -r -- "$dev_list" | awk -F'[][]' \
  '/AVFoundation audio devices/{a=1} a && /\] Meeting Input$/{print $4; exit}')
if [[ -z $idx ]]; then
  print -u2 "record: could not find the 'Meeting Input' audio device."
  exit 1
fi

# 5. Record until Ctrl-C. `|| true` so a SIGINT stop still prints the next step.
# Capture ALL aggregate channels as-is (no downmix): mic first, BlackHole last,
# so transcribe-meeting can split near (mic/[Me]) from far (system/[Them]).
mkdir -p "$HOME/Recordings"
out="$HOME/Recordings/${name}-$(date +%Y%m%d-%H%M%S).m4a"
print "Recording 'Meeting Input' (index $idx) -> $out"
print "Press Ctrl-C ONCE to stop (repeated presses hard-kill ffmpeg)."
# Fragmented mp4 (empty_moov + 5s fragments): file stays readable even if
# ffmpeg is hard-killed (e.g. repeated Ctrl-C) — at most the last ~5s are lost.
# Backgrounded so the language prompt below costs ZERO audio: capture is already
# running while it waits. -nostdin so ffmpeg doesn't swallow that keypress.
ffmpeg -nostdin -hide_banner -loglevel warning -f avfoundation -i ":$idx" \
  -c:a aac -b:a 96k \
  -movflags +empty_moov+default_base_moof -frag_duration 5000000 "$out" &
ff_pid=$!

# zsh without job control does NOT forward the terminal's SIGINT to a background
# job, so Ctrl-C has to be relayed by hand. SIGINT (never KILL) so ffmpeg
# finalizes the file on the way out.
stop() { kill -INT "$ff_pid" 2>/dev/null || true; }
trap 'stop; restore' INT TERM

# Language, asked WHILE recording — it isn't needed until transcription (after
# Ctrl-C), so a slow answer costs no audio. Default Hebrew on N / silence / no tty.
# The 5s timeout is enforced by the tty driver (min 0 time 50 = return after at
# most 5s with whatever's there), NOT by `read -t`: zsh's `read -q -t5` never
# times out at all, and `read -k1 -t5` proved unreliable here. The driver can't
# hang, so a missed keypress can never strand a recording. Tested 2026-08-11.
lang=he
if [[ -t 0 ]]; then
  stty_saved=$(stty -g 2>/dev/null || true)
  if [[ -n $stty_saved ]] && stty -icanon min 0 time 50 2>/dev/null; then
    print -n "Meeting in English? [y/N] (5s, default Hebrew) "
    ans=$(dd bs=1 count=1 2>/dev/null)
    stty "$stty_saved" 2>/dev/null || true
    [[ $ans == [yY] ]] && lang=en
    print ""
  fi
fi
print "Language: $lang"
export TRANSCRIBE_LANG=$lang

# `wait` is interrupted by the trap, so loop until ffmpeg is actually gone.
while kill -0 "$ff_pid" 2>/dev/null; do wait "$ff_pid" 2>/dev/null || true; done
restore   # explicit: Ctrl-C already restored via the INT trap, but a natural stop hasn't

print ""
if [[ ! -f $out ]]; then
  print -u2 "record: no file was written."
  exit 1
fi
print "Saved: $out"
txt="${out:r}.txt"

# Pass the user's name to Notion only if they actually gave one.
nm=("$out")
[[ -n $name_arg ]] && nm+=("$name_arg")

if ! "${0:A:h}/transcribe-meeting" "$out"; then
  print -u2 "record: transcription failed."
  print -u2 "Recording is safe at: $out"
  print -u2 "Retry with:  notion-meeting \"$out\"${name_arg:+ \"$name_arg\"}"
  exit 1
fi
if ! "${0:A:h}/notion-meeting" "${nm[@]}"; then
  print -u2 "record: Notion upload failed (transcript is on disk)."
  print -u2 "Retry with:  notion-meeting \"$out\"${name_arg:+ \"$name_arg\"}"
  exit 1
fi

print ""
print "Saved:      $out"
print "Transcript: $txt"
# notion-meeting already printed the page URL as "Notion: <url>"
