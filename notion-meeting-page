#!/usr/bin/env zsh
# notion-meeting-page <title> <date-utc-iso>
# Creates a Meeting Notes page whose body starts with an empty "My Notes"
# section (Roy's own notes; the summary and transcript are appended below it).
# Prints the new page id. Used by `record` (at start) and `notion-meeting`.
set -uo pipefail
(( $# == 2 )) || { print -u2 "usage: notion-meeting-page <title> <date-utc-iso>"; exit 2; }

token=$(security find-generic-password -a notion-meeting -s notion-api-token -w) || exit 1
# The Meeting Notes database's data source id (Notion: database ... -> Copy data source ID).
ds=${NOTION_MEETINGS_DS:-$(security find-generic-password -a notion-meeting -s notion-meetings-ds -w 2>/dev/null)}
[[ -n $ds ]] || { print -u2 "notion-meeting-page: set NOTION_MEETINGS_DS, or:
  security add-generic-password -a notion-meeting -s notion-meetings-ds -w <data-source-id>"; exit 1; }
body=$(jq -n --arg t "$1" --arg d "$2" --arg ds "$ds" '{
  parent: {type: "data_source_id", data_source_id: $ds},
  properties: {"Meeting name": {title: [{text: {content: $t}}]}, Date: {date: {start: $d}}},
  children: [
    {type: "heading_2", heading_2: {rich_text: [{text: {content: "My Notes"}}]}},
    {type: "paragraph", paragraph: {rich_text: []}}
  ]}')
# 2025-09-03: the first API version that takes a data_source_id parent.
print -r -- "Authorization: Bearer $token" | curl -sSf -m 20 -X POST \
  https://api.notion.com/v1/pages -H @- \
  -H "Notion-Version: 2025-09-03" -H "Content-Type: application/json" -d "$body" \
  | jq -re '.id | gsub("-"; "")'
